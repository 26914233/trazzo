    {"id": "one_time", "label": "Pide pago único / comprar la app", "kind": "request",
     "patterns": ["\\bone.?time\\b", "\\blifetime\\b", "\\bpay once\\b", "\\bbuy the (app|game|full)\\b", "\\bwould (gladly |happily )?pay\\b", "\\bpago [uú]nico\\b", "\\buna sola vez\\b", "\\bpagar[ií]a\\b", "\\bcomprar(la)? (la app|el juego)\\b"]},
    {"id": "remove_ads", "label": "Pide opción para quitar anuncios", "kind": "request",
     "patterns": ["\\bremove (the )?ads\\b", "\\bad.?free\\b", "\\bno.?ads option\\b", "\\bsin anuncios\\b", "\\bquitar (los )?anuncios\\b", "\\bsin publicidad\\b"]},
    {"id": "more_content", "label": "Más contenido o novedades", "kind": "request",
     "patterns": ["\\bmore (pictures|pages|puzzles|words|levels|images|categories|designs)\\b", "\\bnew (pictures|pages|puzzles|images)\\b", "\\bm[aá]s (dibujos|im[aá]genes|niveles|palabras|categor[ií]as)\\b", "\\bnuevos? (dibujos|niveles)\\b"]},
    {"id": "difficulty", "label": "Más dificultad o elegir nivel", "kind": "request",
     "patterns": ["\\bharder\\b", "\\bmore (difficult|challenging)\\b", "\\bdifficulty\\b", "\\bdificultad\\b", "\\bm[aá]s dif[ií]cil", "\\bm[aá]s reto\\b"]},
    {"id": "creative", "label": "Libertad creativa (elegir color, pincel)", "kind": "request",
     "patterns": ["\\bchoose (my own |your own )?colou?rs?\\b", "\\bpick (my own |your own )?colou?rs?\\b", "\\bbrush", "\\bfreehand\\b", "\\bpalettes?\\b", "\\bgradient", "\\belegir (los |mis )?colores\\b", "\\bpincel", "\\bpaleta", "\\bdegradad"]},
    {"id": "offline", "label": "Jugar sin conexión", "kind": "request",
     "patterns": ["\\boffline\\b", "\\bwi.?fi\\b", "\\binternet\\b", "\\bsin (internet|conexi[oó]n)\\b"]},
    {"id": "accessibility", "label": "Legibilidad y accesibilidad (letra, contraste, vista)", "kind": "request",
     "patterns": ["\\bfont\\b", "\\bbigger\\b", "\\blarger\\b", "\\beyes(ight)?\\b", "\\bcontrast\\b", "\\bletras? (m[aá]s )?(grandes?|peque)", "\\bvista\\b", "\\bojos\\b", "\\bseniors?\\b", "\\belderly\\b"]},
    {"id": "daily_streak", "label": "Diario, rachas y eventos", "kind": "request",
     "patterns": ["\\bdaily\\b", "\\bstreak", "\\bevents?\\b", "\\bdiari[oa]\\b", "\\bracha", "\\beventos?\\b"]},
    {"id": "share_save", "label": "Guardar, compartir, exportar", "kind": "request",
     "patterns": ["\\bshar(e|ing)\\b", "\\bexport", "\\bsave (to|in) (my )?(gallery|photos|camera roll)\\b", "\\bwallpaper\\b", "\\bcompartir\\b", "\\bguardar\\b", "\\bgaler[ií]a\\b"]}
  ]
}
