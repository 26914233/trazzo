{
  "_about": "Temas para reseñas de juegos móviles casuales (sopas de letras y colorear), en inglés y español. Adaptado de themes.json de replica-entrepreneur (MIT). Patrones regex, sin distinguir mayúsculas.",
  "request_patterns": [
    "\\bi wish\\b",
    "\\bplease (add|make|bring|give|let)\\b",
    "\\bwould be (nice|great|good|helpful|awesome)\\b",
    "\\bwould love\\b",
    "\\bwould (gladly |happily )?pay\\b",
    "\\bneeds? (a|an|the|to|more)\\b",
    "\\bno way to\\b",
    "\\bthere'?s no (way|option)\\b",
    "\\b(missing|lacks|lacking)\\b",
    "\\bdoesn'?t (have|support|let|allow)\\b",
    "\\bif only\\b",
    "\\bwhy (can'?t|isn'?t|doesn'?t|not)\\b",
    "\\bojal[aá]\\b",
    "\\bme gustar[ií]a\\b",
    "\\bdeber[ií]an\\b",
    "\\bpodr[ií]an\\b",
    "\\bser[ií]a (bueno|genial|lindo|bonito|mejor|ideal)\\b",
    "\\bfalta(n)?\\b",
    "\\bno hay (forma|opci[oó]n|manera)\\b",
    "\\bpor favor\\b"
  ],
  "themes": [
    {"id": "ads", "label": "Anuncios (exceso, interrupciones)", "kind": "complaint",
     "patterns": ["\\bads?\\b", "\\badvert", "\\bcommercials?\\b", "\\bpop.?ups?\\b", "\\banuncios?\\b", "\\bpublicidad", "\\bpropaganda"]},
    {"id": "ads_forced", "label": "Anuncios largos, forzados o tras cada nivel", "kind": "complaint",
     "patterns": ["\\b(15|20|30|45|60) ?(sec|second|seg)", "\\bevery (single )?(level|puzzle|game|picture|image|round|board|time)\\b", "\\bafter each\\b", "\\bunskippable\\b", "\\bcan'?t (skip|close)\\b", "\\bcada (nivel|sopa|partida|dibujo|imagen|vez)\\b", "\\bno se puede(n)? (saltar|quitar|cerrar)\\b", "\\bminutes? (long|of ads)\\b"]},
    {"id": "pricing", "label": "Precio, suscripción y muros de pago", "kind": "complaint",
     "patterns": ["\\bsubscri", "\\bsuscrip", "\\bweekly\\b", "\\b(per|a|each) week\\b", "\\bsemanal", "\\bpor semana\\b", "\\bexpensive\\b", "\\boverpriced\\b", "\\bcar[oa]s?\\b", "\\bpaywall", "\\bpremium\\b", "\\bvip\\b", "\\bnot worth\\b", "\\bpric(e|es|ey|ing)\\b", "\\bprecio", "\\bpagar\\b", "\\bpay (for|to)\\b", "\\$\\s?\\d"]},
    {"id": "word_quality", "label": "Errores de ortografía, palabras inventadas o fuera de tema", "kind": "complaint",
     "patterns": ["\\bfaltas? de or?tograf", "\\borograf", "\\berratas?\\b", "\\bno existen\\b", "\\bse las invent", "\\bpalabras en ingl[eé]s\\b", "\\bmisspel", "\\bspelling\\b", "\\bwrong words\\b", "\\btypos?\\b", "\\bgazapos?\\b", "\\bno tienen que ver con la categor", "\\bwrong topics?\\b"]},
    {"id": "performance", "label": "Batería y lentitud", "kind": "complaint",
     "patterns": ["\\bbattery\\b", "\\bbater[ií]a\\b", "\\bslow\\b", "\\blent[oa]\\b", "\\blaggy\\b"]},
    {"id": "locked", "label": "Casi todo bloqueado, poco contenido gratis", "kind": "complaint",
     "patterns": ["\\blocked\\b", "\\bbloquead", "\\bonly (a few|one|1|two|2|3) free\\b", "\\bfew free\\b", "\\bpocos? (dibujos |im[aá]genes )?gratis", "\\bsolo (una|uno|1) gratis", "\\bfree (pictures|images|pages|ones)\\b", "\\bmost (of the )?(pictures|images|pages) (are|require)"]},
    {"id": "billing", "label": "Cobros, cancelaciones y reembolsos", "kind": "complaint",
     "patterns": ["\\bcharged\\b", "\\brefund", "\\bcancel(l?ing|l?ed|lation)?\\b", "\\bauto.?renew", "\\bscam\\b", "\\bcobr(o|aron|an)\\b", "\\breembolso", "\\bestafa", "\\brestore (my )?purchase", "\\brestaurar"]},
    {"id": "bugs", "label": "Fallos, cierres y cuelgues", "kind": "complaint",
     "patterns": ["\\bcrash(es|ed|ing)?\\b", "\\bbugs?\\b", "\\bbuggy\\b", "\\bglitch", "\\bfreez(e|es|ing)\\b", "\\b(doesn'?t|does not|stopped) work", "\\bnot working\\b", "\\bse (cierra|traba|congela|queda)\\b", "\\bno (abre|funciona|carga)\\b", "\\berror\\b"]},
    {"id": "progress", "label": "Progreso u obras perdidas", "kind": "complaint",
     "patterns": ["\\blost (my|all)\\b", "\\bprogress (is |was )?(gone|lost|reset)", "\\bdisappear", "\\bwiped\\b", "\\bstart(ed)? over\\b", "\\bperd[ií]\\b", "\\bdesaparec", "\\bse borr", "\\bmis (dibujos|obras|niveles)\\b"]},
    {"id": "easy_repetitive", "label": "Demasiado fácil o repetitivo", "kind": "complaint",
     "patterns": ["\\btoo easy\\b", "\\bboring\\b", "\\brepe(at|ti)", "\\bsame (words|pictures|puzzles|images|ones)\\b", "\\bmuy f[aá]cil", "\\baburrid", "\\brepit", "\\bmismas? (palabras|im[aá]genes|dibujos)\\b", "\\bno (challenge|challenging)\\b"]},
    {"id": "tiny_areas", "label": "Zonas diminutas o difíciles de encontrar", "kind": "complaint",
     "patterns": ["\\btiny\\b", "\\btoo small\\b", "\\bcan'?t (find|see)\\b", "\\bhard to (see|find)\\b", "\\bmagnif", "\\bno (encuentro|se ve|veo)\\b", "\\bmuy peque", "\\bdiminut", "\\blupa\\b", "\\blast (cell|spot|area|piece|few)\\b"]},
    {"id": "hints_coins", "label": "Pistas y monedas escasas o caras", "kind": "complaint",
