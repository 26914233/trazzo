; Proyecto de Godot 4.7 — prototipos de juegos de puzles tipo The Room.
; Cuatro piezas sobre un mismo núcleo: la caja viva, la caja del relojero, la reliquia y el cuarto
; del farero. Renderizador Compatibility: el más ligero; funciona en PC modestos y en Android.

config_version=5

[application]

config/name="Puzles (prototipos)"
config/description="Cuatro prototipos de juegos de puzles tipo The Room para probar en el móvil."
run/main_scene="res://principal.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://icono.png"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=6

[input_devices]

pointing/emulate_touch_from_mouse=true

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
anti_aliasing/quality/msaa_3d=1
lights_and_shadows/positional_shadow/atlas_size=2048
lights_and_shadows/directional_shadow/size=2048
